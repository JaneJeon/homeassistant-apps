+function normalizeResult(name: string, args: any, result: any) {
+  if (name === "download_document" && typeof result?.blob === "string") {
+    const filename = String(result.filename || `document-${args.id}`);
+    const suffix = filename.toLowerCase().split(".").pop();
+    const mimeType =
+      suffix === "pdf" ? "application/pdf" :
+      suffix === "png" ? "image/png" :
+      suffix === "jpg" || suffix === "jpeg" ? "image/jpeg" :
+      "application/octet-stream";
+    return {
+      content: [{
+        type: "resource",
+        resource: {
+          uri: `paperless://documents/${args.id}/${args.original ? "original" : "archive"}`,
+          mimeType,
+          blob: result.blob,
+        },
+      }],
+    };
+  }
+  return { content: [{ type: "text", text: JSON.stringify(result) ?? "null" }] };
+}
+
+// The pinned upstream registers writes alongside reads in each tool module.
+// Intercept registration so writes are neither listed nor callable, and wrap
+// the upstream callbacks in the MCP result envelope required by newer SDKs.
+function createReadOnlyServer(api: PaperlessAPI): McpServer {
+  const server = new McpServer({ name: "paperless-ngx", version: "1.0.0" });
+  const readOnlyRegistration = new Proxy(server, {
+    get(target, property, receiver) {
+      if (property !== "tool") return Reflect.get(target, property, receiver);
+      return (name: string, ...args: any[]) => {
+        if (!READ_TOOLS.has(name)) return undefined;
+        const register = target.tool as (...toolArgs: any[]) => unknown;
+        const callback = args.pop();
+        if (typeof callback !== "function") throw new Error(`Tool ${name} has no callback`);
+        return register.call(target, name, ...args, async (...callArgs: any[]) => {
+          const result = await callback(...callArgs);
+          return normalizeResult(name, callArgs[0], result);
+        });
+      };
+    },
+  });
+
+  registerDocumentTools(readOnlyRegistration, api);
+  registerTagTools(readOnlyRegistration, api);
+  registerCorrespondentTools(readOnlyRegistration, api);
+  registerDocumentTypeTools(readOnlyRegistration, api);
+  return server;
+}
